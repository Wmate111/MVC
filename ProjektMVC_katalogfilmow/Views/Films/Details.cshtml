@model katalogfilmowMVC.Models.Film

@{
    ViewData["Title"] = "Szczegóły filmu";
}

<h1>Szczegóły filmu</h1>

<div class="card mt-4">
    <div class="card-header bg-dark text-white">
        <h4 class="mb-0">@Model.Tytul</h4>
    </div>

    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Tytul)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Tytul)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Rezyser)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Rezyser)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Gatunek)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Gatunek)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.RokProdukcji)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.RokProdukcji)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Ocena)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Ocena)/10
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Opis)
            </dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrWhiteSpace(Model.Opis))
                {
                    @Html.DisplayFor(model => model.Opis)
                }
                else
                {
                    <span class="text-muted">Brak opisu.</span>
                }
            </dd>
        </dl>
    </div>

    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edytuj</a>
        <a asp-action="Index" class="btn btn-secondary">Powrót do listy</a>
    </div>
</div>